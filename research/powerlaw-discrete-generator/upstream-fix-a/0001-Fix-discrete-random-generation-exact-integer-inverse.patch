diff --git a/testing/test_discrete_generation.py b/testing/test_discrete_generation.py
new file mode 100644
index 0000000..424f779
--- /dev/null
+++ b/testing/test_discrete_generation.py
@@ -0,0 +1,205 @@
+"""
+This test file checks that discrete random numbers are drawn with the
+correct probabilities, using deterministic quantiles instead of random
+seeds.
+
+The reference values come from an independent implementation of the
+discrete power law, P(K = k) = k^(-alpha) / zeta(alpha, xmin), with the
+Hurwitz zeta function from mpmath. The package itself uses scipy, so the
+reference does not share any code with the functions being tested.
+"""
+
+import unittest
+from unittest import mock
+
+import numpy as np
+import mpmath
+
+import powerlaw
+
+
+def exact_ccdf(alpha, xmin, k):
+    """P(K >= k) of the discrete power law on the integers >= xmin."""
+    return float(mpmath.zeta(alpha, k) / mpmath.zeta(alpha, xmin))
+
+
+def exact_inverse(alpha, xmin, u):
+    """Smallest integer k >= xmin with P(K <= k) >= u, ie. the largest k with
+    P(K >= k) >= 1 - u."""
+    k = xmin
+    while exact_ccdf(alpha, xmin, k + 1) >= 1 - u:
+        k += 1
+    return k
+
+
+def quantile_grid(alpha, xmin, n=60, umax=0.99):
+    """Quantiles spread over [0, umax] that stay away from the steps of the
+    exact CDF, so that round-off cannot decide a comparison."""
+    grid = (np.arange(n) + 0.5) / n * umax
+    steps = [1 - exact_ccdf(alpha, xmin, k) for k in range(xmin + 1, xmin + 400)]
+    return [u for u in grid if min(abs(u - s) for s in steps) > 1e-9]
+
+
+def exact_power_law(xmin, alpha, xmax=None, parameter_ranges=None):
+    kwargs = {}
+    if parameter_ranges:
+        kwargs['parameter_ranges'] = parameter_ranges
+    return powerlaw.Power_Law(xmin=xmin, xmax=xmax, parameters=[alpha],
+                              discrete=True, estimate_discrete=False, **kwargs)
+
+
+class TestExactDiscreteSearch(unittest.TestCase):
+
+    def test_reported_counterexample(self):
+        """
+        alpha = 2.5, xmin = 5: P(K = 5) = 0.2581, so u = 0.30 must give 6.
+        """
+        dist = exact_power_law(xmin=5, alpha=2.5)
+        assert dist._double_search_discrete(0.30) == 6
+
+
+    def test_quantiles_match_exact_inverse(self):
+        """
+        The inverse search must agree with the exact inverse CDF for every
+        quantile, for xmin values that are and are not powers of two.
+        """
+        for alpha in [1.8, 2.5]:
+            for xmin in [1, 2, 3, 5, 6, 10, 20]:
+                dist = exact_power_law(xmin=xmin, alpha=alpha)
+                for u in quantile_grid(alpha, xmin):
+                    assert dist._double_search_discrete(u) == exact_inverse(alpha, xmin, u), \
+                        f'alpha={alpha}, xmin={xmin}, u={u}'
+
+
+    def test_quantiles_steep_power_law(self):
+        """
+        alpha = 3.5 is outside the default fitting range (alpha <= 3), which
+        is a separate issue, so the range is widened here.
+        """
+        for xmin in [1, 3, 5]:
+            dist = exact_power_law(xmin=xmin, alpha=3.5, parameter_ranges={'alpha': [1, 10]})
+            for u in quantile_grid(3.5, xmin):
+                assert dist._double_search_discrete(u) == exact_inverse(3.5, xmin, u), \
+                    f'alpha=3.5, xmin={xmin}, u={u}'
+
+
+    def test_probability_mass_decreases(self):
+        """
+        The probability that the search assigns to each integer (the width
+        of its quantile interval) must decrease with k for a power law, and
+        match the exact probabilities.
+        """
+        n = 4000
+        grid = (np.arange(n) + 0.5) / n
+        for xmin in [3, 5, 6, 10]:
+            dist = exact_power_law(xmin=xmin, alpha=2.5)
+            values = np.array([dist._double_search_discrete(u) for u in grid])
+            counts = np.array([(values == k).sum() for k in range(xmin, xmin + 8)]) / n
+            assert np.all(np.diff(counts) < 0), f'xmin={xmin}: {counts}'
+            expected = np.array([exact_ccdf(2.5, xmin, k) - exact_ccdf(2.5, xmin, k + 1)
+                                 for k in range(xmin, xmin + 8)])
+            np.testing.assert_allclose(counts, expected, atol=1.5/n)
+
+
+    def test_lowest_quantile(self):
+        """
+        u = 0 is a valid draw of np.random.uniform(0, 1) and must give xmin.
+        """
+        for xmin in [1, 5]:
+            assert exact_power_law(xmin=xmin, alpha=2.5)._double_search_discrete(0.0) == xmin
+
+
+    def test_non_integer_xmin_is_rejected(self):
+        """
+        The discrete distributions are normalized on xmin, xmin + 1, ...
+        (the Hurwitz zeta function), which are not integers when xmin is not;
+        integer sampling is then undefined and should say so.
+        """
+        dist = exact_power_law(xmin=5.5, alpha=2.5)
+        with self.assertRaises(ValueError):
+            dist._double_search_discrete(0.3)
+
+
+    def test_xmax_is_respected(self):
+        """
+        With a finite xmax, no quantile may produce a value above xmax, and
+        values below xmax still follow the exact inverse of the distribution's
+        own CCDF.
+        """
+        dist = exact_power_law(xmin=5, alpha=2.5, xmax=50)
+        values = [dist._double_search_discrete(u) for u in np.linspace(1e-6, 1 - 1e-12, 500)]
+        assert max(values) <= 50
+        assert min(values) == 5
+        for u in [0.1, 0.3, 0.6, 0.9]:
+            k = dist._double_search_discrete(u)
+            assert dist.ccdf(data=[k])[0] >= 1 - u
+            if k < 50:
+                assert dist.ccdf(data=[k + 1])[0] < 1 - u
+
+
+    def test_generate_random_uses_the_exact_inverse(self):
+        """
+        Public interface: with np.random.uniform replaced by a fixed grid of
+        quantiles, generate_random must return the exact inverse of each.
+        """
+        alpha, xmin = 2.5, 5
+        grid = np.array(quantile_grid(alpha, xmin, n=40))
+        dist = exact_power_law(xmin=xmin, alpha=alpha)
+        with mock.patch('numpy.random.uniform', return_value=grid):
+            data = dist.generate_random(len(grid))
+        assert list(data) == [exact_inverse(alpha, xmin, u) for u in grid]
+
+
+class TestApproximateDiscreteGeneration(unittest.TestCase):
+
+    def test_mass_at_xmin(self):
+        """
+        The approximation of Clauset et al. (2009, Eq. D.6) floors
+        (xmin - 1/2)(1 - u)^(-1/(alpha - 1)) + 1/2. Its mass at xmin,
+        1 - ((xmin - 1/2)/(xmin + 1/2))^(alpha - 1), is within 0.5% of the
+        exact value for xmin >= 10 (0.1395 against 0.1391 at xmin = 10).
+        """
+        n = 20000
+        grid = (np.arange(n) + 0.5) / n
+        for xmin in [10, 20, 50]:
+            dist = powerlaw.Power_Law(xmin=xmin, parameters=[2.5], discrete=True, estimate_discrete=True)
+            values = dist._generate_random_discrete_estimate(grid)
+            p_xmin = np.mean(values == xmin)
+            exact = exact_ccdf(2.5, xmin, xmin) - exact_ccdf(2.5, xmin, xmin + 1)
+            np.testing.assert_allclose(p_xmin, exact, rtol=0.01, err_msg=f'xmin={xmin}')
+
+
+    def test_cdf_close_to_exact(self):
+        """
+        Over the whole distribution the approximate CDF stays within 0.002 of
+        the exact one for xmin = 10.
+        """
+        n = 20000
+        grid = (np.arange(n) + 0.5) / n
+        xmin = 10
+        dist = powerlaw.Power_Law(xmin=xmin, parameters=[2.5], discrete=True, estimate_discrete=True)
+        values = dist._generate_random_discrete_estimate(grid)
+        for k in range(xmin, 200, 7):
+            approx = np.mean(values <= k)
+            exact = 1 - exact_ccdf(2.5, xmin, k + 1)
+            assert abs(approx - exact) < 0.002, f'k={k}: {approx} vs {exact}'
+
+
+    def test_generate_random_respects_xmax(self):
+        """
+        The approximate path searches for the largest quantile that stays
+        below xmax; with the floor the values must stay in [xmin, xmax - 1]
+        (the support of the distribution's CDF) and reach xmax - 1.
+        """
+        xmin, xmax = 10, 100
+        dist = powerlaw.Power_Law(xmin=xmin, xmax=xmax, parameters=[2.5], discrete=True, estimate_discrete=True)
+        # quantiles spread evenly over whatever range the code asks for
+        grid = lambda low, high, size: low + (high - low) * (np.arange(size) + 0.5) / size
+        with mock.patch('numpy.random.uniform', side_effect=grid):
+            data = dist.generate_random(20000)
+        assert data.min() == xmin
+        assert data.max() == xmax - 1
+
+
+if __name__ == '__main__':
+    unittest.main()
