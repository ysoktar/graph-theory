From 6f93029886ffd2ba0d22cee3ab3482ec2b49906d Mon Sep 17 00:00:00 2001
From: powerlaw contributor <contributor@example.invalid>
Date: Thu, 29 Oct 2026 12:45:55 +0000
Subject: [PATCH] Raise instead of hanging when generating discrete data
 outside parameter_ranges

Outside parameter_ranges, cdf() returns ~0 for every x, so the doubling
search in _double_search_discrete never finds its target and
generate_random() loops forever (with xmax it raises an unrelated
TypeError). With the default Power_Law range (0, 3) this affects every
hand-built discrete power law with alpha >= 3.

- generate_random(): in the exact discrete branch, check in_range() once
  and raise a ValueError naming the parameter, its value and its range.
- testing/test_generation_out_of_range.py: hanging calls run in a
  subprocess with a timeout, so a regression fails instead of hanging.
---
 powerlaw/distributions.py               |  27 +++++
 testing/test_generation_out_of_range.py | 152 ++++++++++++++++++++++++
 2 files changed, 179 insertions(+)
 create mode 100644 testing/test_generation_out_of_range.py

diff --git a/powerlaw/distributions.py b/powerlaw/distributions.py
index 83c06c0..54f25ea 100644
--- a/powerlaw/distributions.py
+++ b/powerlaw/distributions.py
@@ -1205,6 +1205,26 @@ class Distribution(object):
         return False
 
 
+    def _out_of_range_message(self):
+        """
+        Explain which parameters lie outside ``self.parameter_ranges``, for
+        error messages.
+        """
+        outside = []
+        for p in self.parameter_names:
+            lo, hi = self.parameter_ranges[p]
+            value = getattr(self, p)
+            if (lo is not None and not value > lo) or (hi is not None and not value < hi):
+                outside.append(f'{p} = {value} (allowed range ({lo}, {hi}), bounds excluded)')
+
+        what = ', '.join(outside) if outside else f'parameters {self.parameters} (a parameter constraint is not satisfied)'
+        example = ', '.join(f"'{p}': [..]" for p in self.parameter_names)
+        return (f'Cannot generate discrete random numbers from {self.name}: {what}. '
+                f'Outside parameter_ranges the cdf() is not computed, so the exact '
+                f'discrete generator cannot be used. Pass parameter_ranges={{{example}}} '
+                f'that include these values when creating the distribution.')
+
+
     def in_range(self):
         """
         Whether the current parameters (``self.parameters``) of the
@@ -1672,6 +1692,13 @@ class Distribution(object):
                     r = np.minimum(r, int(np.ceil(self.xmax)) - 1)
 
             else:
+                # The exact method searches the ccdf, which is (nearly)
+                # constant when the parameters are outside of
+                # parameter_ranges (see cdf()), so the search could never
+                # finish. Check once here instead of hanging.
