diff --git a/testing/test_generation_out_of_range.py b/testing/test_generation_out_of_range.py
new file mode 100644
index 0000000..2b2daad
--- /dev/null
+++ b/testing/test_generation_out_of_range.py
@@ -0,0 +1,152 @@
+"""
+This test file checks that generating random numbers from a discrete
+distribution whose parameters lie outside ``parameter_ranges`` terminates.
+
+Outside its parameter ranges a distribution's ``cdf()`` returns (nearly)
+zero, so the inverse search in the exact discrete generator never finds
+its target. Generation must fail promptly with a clear error instead of
+looping forever.
+
+Each potentially hanging call runs in a separate interpreter with a
+timeout, so a regression shows up as a failed test rather than a hung
+test suite.
+"""
+
+import subprocess
+import sys
+import textwrap
+import unittest
+
+import pytest
+
+import powerlaw
+
+import numpy as np
+
+# Generous: a correct implementation answers in well under a second.
+TIMEOUT = 30
+
+
+def run_isolated(code):
+    """
+    Run ``code`` in a fresh Python interpreter and return
+    ``(returncode, stdout, stderr)``, or ``None`` if it did not finish
+    within ``TIMEOUT`` seconds.
+    """
+    source = "import warnings\nwarnings.filterwarnings('ignore')\nimport numpy as np\nimport powerlaw\nnp.random.seed(0)\n" + textwrap.dedent(code)
+    try:
+        p = subprocess.run([sys.executable, "-c", source], capture_output=True, text=True, timeout=TIMEOUT)
+    except subprocess.TimeoutExpired:
+        return None
+    return p.returncode, p.stdout, p.stderr
+
+
+class TestGenerationOutOfRange(unittest.TestCase):
+
+    def assert_raises_promptly(self, construction, exception="ValueError"):
+        """
+        ``construction`` builds a distribution ``d``; calling
+        ``d.generate_random(5)`` must raise ``exception`` (a name in the
+        builtins) instead of hanging.
+        """
+        code = construction + textwrap.dedent(f"""
+        try:
+            d.generate_random(5)
+        except {exception} as e:
+            print('RAISED', e)
+        else:
+            print('NO ERROR')
+        """)
+        result = run_isolated(code)
+        assert result is not None, f'generate_random did not return within {TIMEOUT} s for: {construction.strip()}'
+        returncode, stdout, stderr = result
+        assert returncode == 0, stderr
+        assert 'RAISED' in stdout, f'expected a {exception}, got: {stdout.strip()}'
+        return stdout
+
+
+    def test_power_law_alpha_above_default_range(self):
+        """
+        alpha = 3.5 is a valid power law, but outside the default fitting
+        range alpha in (0, 3).
+        """
+        out = self.assert_raises_promptly(
+            "d = powerlaw.Power_Law(xmin=1, parameters=[3.5], discrete=True, estimate_discrete=False)\n")
+        # The message should name the parameter and show how to fix it
+        assert 'alpha' in out and 'parameter_ranges' in out
+
+
+    def test_power_law_alpha_on_range_boundary(self):
+        """
+        in_range() uses strict inequalities, so alpha = 3 (the exponent of
+        the Barabasi-Albert model) is also outside the default range.
+        """
+        self.assert_raises_promptly(
+            "d = powerlaw.Power_Law(xmin=1, parameters=[3.0], discrete=True, estimate_discrete=False)\n")
+
+
+    def test_power_law_out_of_range_with_xmax(self):
+        self.assert_raises_promptly(
+            "d = powerlaw.Power_Law(xmin=1, xmax=1000, parameters=[3.5], discrete=True, estimate_discrete=False)\n")
+
+
+    def test_other_distributions_out_of_range(self):
+        """
+        The same search is used by every distribution without a discrete
+        approximation.
+        """
+        constructions = [
+            "d = powerlaw.Truncated_Power_Law(xmin=1, parameters=[3.5, 0.01], discrete=True)\n",
+            "d = powerlaw.Exponential(xmin=1, parameters=[-0.1], discrete=True)\n",
+            "d = powerlaw.Lognormal(xmin=1, parameters=[1, -1], discrete=True)\n",
+        ]
+        for c in constructions:
+            self.assert_raises_promptly(c)
+
+
+    def test_widened_range_generates_valid_integers(self):
+        """
+        Widening parameter_ranges to include the parameters makes the same
+        distribution usable.
+        """
+        dist = powerlaw.Power_Law(xmin=2, parameters=[3.5], discrete=True, estimate_discrete=False,
+                                  parameter_ranges={'alpha': [1, 10]})
+        assert dist.in_range()
+
+        np.random.seed(1)
+        data = dist.generate_random(200)
+
+        assert len(data) == 200
+        assert np.all(data >= 2)
+        assert np.all(data == np.round(data))
+
+
+    def test_in_range_generation_unchanged(self):
+        """
+        In-range distributions still generate data (smoke test for the new
+        check).
+        """
+        dist = powerlaw.Power_Law(xmin=1, parameters=[2.5], discrete=True, estimate_discrete=False)
+        np.random.seed(2)
+        data = dist.generate_random(100)
+
+        assert len(data) == 100
+        assert np.all(data >= 1)
+
+
+    def test_continuous_and_estimate_paths_unaffected(self):
+        """
+        The continuous generator and the discrete approximation do not use
+        cdf(), so they generate values even outside parameter_ranges. That
+        behaviour is not changed.
+        """
+        np.random.seed(3)
+        cont = powerlaw.Power_Law(xmin=1, parameters=[3.5], discrete=False).generate_random(50)
+        assert np.all(cont >= 1)
+
+        est = powerlaw.Power_Law(xmin=10, parameters=[3.5], discrete=True, estimate_discrete=True).generate_random(50)
+        assert np.all(est >= 10)
+
+
+if __name__ == '__main__':
+    unittest.main()
